@page "/films/{Id:int}"
@attribute [Authorize]
@inject MovieQueries Queries
@inject NavigationManager Navigation
@inject ILogger<MovieDetailPage> Logger

<PageTitle>@(_movie?.Title ?? "Film")</PageTitle>

<div class="films-page films-page-narrow">
    <a class="films-back" href="@BackUrl">
        <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small"/> Overzicht
    </a>

    @if (_error)
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">De film kon niet worden geladen.</MudAlert>
    }
    else if (!_loaded)
    {
        <div class="films-skeleton" aria-hidden="true">
            <MudSkeleton Height="44px" Animation="Animation.Wave"/>
            <MudSkeleton Height="44px" Animation="Animation.Wave"/>
        </div>
    }
    else if (_movie is null)
    {
        <MudPaper Class="films-notfound pa-6 mt-4" Outlined="true" Elevation="0">
            <h1 class="films-title">Film niet gevonden.</h1>
            <MudButton Href="@BackUrl" Variant="Variant.Outlined" Class="mt-4">Naar overzicht</MudButton>
        </MudPaper>
    }
    else
    {
        <h1 class="films-title mt-2">@_movie.Title</h1>
        <p class="films-summary">@_movie.ReleaseYear · @_movie.Director</p>

        <MudPaper Class="films-detail pa-4 mt-4" Outlined="true" Elevation="0">
            <dl class="films-facts">
                <div><dt>Genre</dt><dd>@_movie.Genre</dd></div>
                <div><dt>Duur</dt><dd class="films-num">@Formats.Runtime(_movie.RuntimeMinutes)</dd></div>
                <div><dt>Gezien op</dt><dd class="films-num">@Formats.Date(_movie.WatchedOn)</dd></div>
                <div><dt>Gezien op/in</dt><dd>@(_movie.Medium ?? "–")</dd></div>
            </dl>
            <div class="films-scores">
                <div><span>Totaal</span><ScorePill Value="_movie.OverallScore" Label="Totaal"/></div>
                <div><span>Verhaal</span><ScorePill Value="_movie.StoryScore" Label="Verhaal"/></div>
                <div><span>Beeld</span><ScorePill Value="_movie.PictureScore" Label="Beeld"/></div>
                <div><span>Muziek</span><ScorePill Value="_movie.MusicScore" Label="Muziek"/></div>
                <div><span>Geluid</span><ScorePill Value="_movie.SoundScore" Label="Geluid"/></div>
                <div><span>Extra's</span><ScorePill Value="_movie.ExtrasScore" Label="Extra's"/></div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_movie.Review))
            {
                <h2 class="films-section">Recensie</h2>
                <p class="films-review">@_movie.Review</p>
            }
        </MudPaper>
        <p class="films-hint">Bewerken komt in een volgende versie.</p>
    }
</div>

@code {
    private MovieDetail? _movie;
    private bool _loaded;
    private bool _error;
    private int _loadedId = -1;

    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    private string? Q { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    private string? Sort { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    private string? PageNumber { get; set; }

    [SupplyParameterFromQuery(Name = "size")]
    private string? PageSizeQuery { get; set; }

    private string BackUrl => "/films" + OverviewState.FromQuery(Q, Sort, PageNumber, PageSizeQuery).ToQueryString();

    protected override async Task OnParametersSetAsync()
    {
        // Prerendering shows the skeleton only; the circuit loads the movie once.
        if (!RendererInfo.IsInteractive || _loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        _loaded = false;
        _error = false;
        try
        {
            _movie = MovieDB.Common.MovieId.TryFrom(Id, out var movieId) ? await Queries.FindAsync(movieId, CancellationToken.None) : null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Loading movie {MovieId} failed.", Id);
            _error = true;
        }

        _loaded = true;
    }
}
