<MudDialog>
    <TitleContent>Bestaat deze film al?</TitleContent>
    <DialogContent>
        <MudText Class="mb-3">
            Er bestaat al een film met de titel <strong>@Title</strong> uit @Year@(Matches.Count == 1 ? "" : ", meerdere keren"):
        </MudText>
        <ul class="films-same-title">
            @foreach (var match in Matches)
            {
                <li>
                    Regisseur: <MudLink Href="@($"/films/{match.Key}")" Target="_blank" rel="noopener noreferrer">@match.Value</MudLink>
                </li>
            }
        </ul>
        <MudText Class="mt-3">Het is mogelijk dat je dezelfde film twee keer invoert. Wat wil je doen?</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Close(SameTitleChoice.Back))">Terug naar formulier</MudButton>
        <MudButton Color="Color.Error" OnClick="@(() => Close(SameTitleChoice.Cancel))">Invoer annuleren</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => Close(SameTitleChoice.Save))">Toch opslaan</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>The title of the movie being saved.</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    /// <summary>The release year of the movie being saved.</summary>
    [Parameter, EditorRequired]
    public int Year { get; set; }

    /// <summary>The existing movies with that title and year: movie id and director.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<KeyValuePair<int, string>> Matches { get; set; } = [];

    private void Close(SameTitleChoice choice) => MudDialog.Close(DialogResult.Ok(choice));
}
