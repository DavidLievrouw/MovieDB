@namespace MovieDB.Ui

<div @ref="_root" tabindex="-1" class="@(Error ? "score-input score-input-invalid" : "score-input")" role="group"
     aria-label="@Label" aria-invalid="@(Error ? "true" : null)">
    <span class="score-input-label">@Label</span>
    <div class="score-input-toggles">
        <MudToggleGroup T="int" Value="Current" ValueChanged="Changed" SelectionMode="SelectionMode.SingleSelection"
                        Color="Color.Primary" Size="Size.Small" Outlined="true" Delimiters="true" Disabled="Disabled">
            @if (AllowEmpty)
            {
                <MudToggleItem T="int" Value="0" Text="@EmptyText"/>
            }
            @for (var score = MinScore; score <= MaxScore; score++)
            {
                <MudToggleItem T="int" Value="score" Text="@score.ToString()"/>
            }
        </MudToggleGroup>
    </div>
    @if (Error && !string.IsNullOrEmpty(ErrorText))
    {
        <span class="score-input-error" role="alert">@ErrorText</span>
    }
</div>

@code {
    /// <summary>The lowest score.</summary>
    public const int MinScore = 1;

    /// <summary>The highest score.</summary>
    public const int MaxScore = 10;

    /// <summary>The score (1–10), or <c>null</c> for an empty score.</summary>
    [Parameter]
    public int? Value { get; set; }

    /// <summary>Raised when the user picks another score; <c>null</c> when the empty option is picked.</summary>
    [Parameter]
    public EventCallback<int?> ValueChanged { get; set; }

    /// <summary>The name of the score; also its accessible name.</summary>
    [Parameter]
    public string Label { get; set; } = "";

    /// <summary>Whether an option that clears the score is offered. Without it, a score can only be changed, not cleared.</summary>
    [Parameter]
    public bool AllowEmpty { get; set; } = true;

    /// <summary>The text of the option that clears the score.</summary>
    [Parameter]
    public string EmptyText { get; set; } = "–";

    /// <summary>Whether the input is disabled.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Whether the input is shown as invalid.</summary>
    [Parameter]
    public bool Error { get; set; }

    /// <summary>The message shown under the input while <see cref="Error"/> is set.</summary>
    [Parameter]
    public string? ErrorText { get; set; }

    private int Current => Value ?? 0;

    private ElementReference _root;

    /// <summary>Moves the focus to the input, which also scrolls it into view.</summary>
    /// <returns>A task that completes when the focus has moved.</returns>
    public async Task FocusAsync() => await _root.FocusAsync();

    private Task Changed(int score) => ValueChanged.InvokeAsync(score == 0 ? null : score);
}
