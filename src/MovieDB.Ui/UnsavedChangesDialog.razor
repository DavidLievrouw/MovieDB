@namespace MovieDB.Ui

<MudDialog>
    <TitleContent>Niet-opgeslagen wijzigingen</TitleContent>
    <DialogContent>
        <MudText>Er zijn wijzigingen die nog niet zijn opgeslagen. Wat wil je doen?</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Close(UnsavedChangesChoice.Stay))">Blijven</MudButton>
        <MudButton Color="Color.Error" OnClick="@(() => Close(UnsavedChangesChoice.Discard))">Niet opslaan</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => Close(UnsavedChangesChoice.Save))">Opslaan</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private void Close(UnsavedChangesChoice choice) => MudDialog.Close(DialogResult.Ok(choice));
}

