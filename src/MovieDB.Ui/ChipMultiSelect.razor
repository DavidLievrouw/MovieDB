@namespace MovieDB.Ui

<div class="chip-multi-select" @attributes="AdditionalAttributes">
    <MudAutocomplete T="string" @ref="_input" @key="_generation" Value="_pending" ValueChanged="AddAsync"
                     TextChanged="OnTextChangedAsync" Label="@LabelText" HelperText="@Hint" SearchFunc="SearchAsync"
                     CoerceValue="AllowNew" CoerceText="false" Immediate="false" ResetValueOnEmptyText="true"
                     DebounceInterval="DebounceMs" MinCharacters="0" OpenOnFocus="true" MaxItems="MaxItems"
                     SelectValueOnTab="false" Variant="Variant.Outlined" Margin="Dense ? Margin.Dense : Margin.None" Error="Error"
                     ErrorText="@ErrorText" MaxLength="MaxLength" Clearable="false" OnBlur="OnBlur"
                     Disabled="Disabled || AtMaximum"/>

    @if (Values.Count > 0)
    {
        <div class="chip-multi-select-chips">
            @foreach (var value in Values)
            {
                var item = value;
                <MudChip T="string" Size="Size.Small" Class="chip-multi-select-chip" Disabled="Disabled"
                         OnClose="@(() => RemoveAsync(item))">
                    @item
                    @if (IsNew(item))
                    {
                        <span class="chip-multi-select-new">nieuw</span>
                    }
                </MudChip>
            }
        </div>
    }
</div>

@code {
    /// <summary>The debounce interval, in milliseconds, between typing and a suggestion lookup.</summary>
    public const int DebounceMs = 150;

    private MudAutocomplete<string>? _input;
    private string? _pending;
    private int _generation;
    private bool _focusAfterRender;

    /// <summary>The selected values, in the order they are shown.</summary>
    [Parameter]
    public IReadOnlyList<string> Values { get; set; } = [];

    /// <summary>Raised with the new list when a value is added or removed.</summary>
    [Parameter]
    public EventCallback<IReadOnlyList<string>> ValuesChanged { get; set; }

    /// <summary>Looks up the suggestions for the typed text (empty text asks for all or the most common ones).</summary>
    [Parameter, EditorRequired]
    public Func<string, CancellationToken, Task<IReadOnlyList<string>>> Suggestions { get; set; } = null!;

    /// <summary>
    /// Whether typed text that is not a suggestion can be added as a value (on Enter, Tab, a comma or leaving the
    /// field). When <c>false</c>, only suggestions can be added.
    /// </summary>
    [Parameter]
    public bool AllowNew { get; set; }

    /// <summary>The largest number of values; the input is disabled when it is reached. <c>null</c> means no maximum.</summary>
    [Parameter]
    public int? MaxSelected { get; set; }

    /// <summary>Tells whether a value is an existing one; a value that is not gets a "nieuw" marker. <c>null</c> marks none.</summary>
    [Parameter]
    public Func<string, bool>? IsKnown { get; set; }

    /// <summary>The label of the field.</summary>
    [Parameter]
    public string Label { get; set; } = "";

    /// <summary>The hint under the field, for example the maximum.</summary>
    [Parameter]
    public string? Hint { get; set; }

    /// <summary>The largest number of suggestions that is shown.</summary>
    [Parameter]
    public int MaxItems { get; set; } = 40;

    /// <summary>The largest number of characters of one value.</summary>
    [Parameter]
    public int MaxLength { get; set; } = 150;

    /// <summary>Whether the label is marked as required (an asterisk). A missing value is reported through <see cref="Error"/>.</summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>Whether the field shows an error.</summary>
    [Parameter]
    public bool Error { get; set; }

    /// <summary>The error message.</summary>
    [Parameter]
    public string? ErrorText { get; set; }

    /// <summary>Raised when the input loses focus.</summary>
    [Parameter]
    public EventCallback<FocusEventArgs> OnBlur { get; set; }

    /// <summary>Whether the field uses the compact height, for example in a toolbar next to other dense fields.</summary>
    [Parameter]
    public bool Dense { get; set; }

    /// <summary>Whether the field is disabled.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Extra attributes, passed on to the wrapping element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    // Required is not passed on: the inner input is always empty, so MudBlazor would flag it as missing on blur even when
    // chips are selected. Whether a value is missing is decided by the parent, through Error.
    private string LabelText => Required ? Label + "*" : Label;

    private bool AtMaximum => MaxSelected is { } max && Values.Count >= max;

    /// <summary>Moves the focus to the input.</summary>
    /// <returns>A task that completes when the focus has been set.</returns>
    public async Task FocusAsync()
    {
        if (_input is not null)
        {
            await _input.FocusAsync();
        }
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusAfterRender && !AtMaximum)
        {
            _focusAfterRender = false;
            await FocusAsync();
        }
    }

    private bool IsNew(string value) => IsKnown is not null && !IsKnown(value);

    private bool Contains(string value) => Values.Contains(value, StringComparer.OrdinalIgnoreCase);

    private async Task<IEnumerable<string>> SearchAsync(string? text, CancellationToken cancellationToken)
    {
        var suggestions = await Suggestions(text?.Trim() ?? "", cancellationToken);
        return suggestions.Where(s => !Contains(s)).Take(MaxItems);
    }

    private async Task OnTextChangedAsync(string? text)
    {
        if (!AllowNew || text is null || !text.Contains(','))
        {
            return;
        }

        // A comma commits what came before it; a pasted list becomes several values.
        await AddRangeAsync(text.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
    }

    private Task AddAsync(string? value) => AddRangeAsync(value is null ? [] : [value]);

    private async Task AddRangeAsync(IEnumerable<string> candidates)
    {
        var next = new List<string>(Values);
        foreach (var candidate in candidates)
        {
            var value = candidate.Trim();
            if (value.Length == 0 || value.Length > MaxLength || next.Contains(value, StringComparer.OrdinalIgnoreCase))
            {
                continue;
            }

            if (MaxSelected is { } max && next.Count >= max)
            {
                break;
            }

            next.Add(value);
        }

        // A new input element clears the typed text; the focus goes back so the next value can be typed at once.
        _pending = null;
        _generation++;
        _focusAfterRender = true;
        if (next.Count != Values.Count)
        {
            await ValuesChanged.InvokeAsync(next);
        }
    }

    private Task RemoveAsync(string value) =>
        ValuesChanged.InvokeAsync([.. Values.Where(v => !string.Equals(v, value, StringComparison.Ordinal))]);
}
