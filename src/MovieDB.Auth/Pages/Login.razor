@page "/login"
@layout AuthLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Aanmelden – Films</PageTitle>

<h1>Films</h1>
<p class="auth-subtitle">Database van films</p>

@if (!string.IsNullOrEmpty(Error))
{
    <p class="auth-error" role="alert">Aanmelden mislukt.</p>
}

@* Plain post to the rate limited /login endpoint: the cookie can only be issued on a real HTTP response. *@
<form method="post" action="@AuthEndpoints.LoginPath">
    <AntiforgeryToken />
    <input type="hidden" name="ReturnUrl" value="@(LocalUrl.IsLocal(ReturnUrl) ? ReturnUrl : "")" />
    <label for="username">Gebruikersnaam</label>
    <input id="username" name="Username" type="text" autocomplete="username" autofocus required maxlength="255" />
    <label for="password">Wachtwoord</label>
    <input id="password" name="Password" type="password" autocomplete="current-password" required maxlength="256" />
    <label class="auth-remember"><input name="RememberMe" type="checkbox" value="true" />Onthoud mij</label>
    <button type="submit">Aanmelden</button>
</form>

@code {
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? Error { get; set; }
}
