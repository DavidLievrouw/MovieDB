@page "/account/wachtwoord"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Wachtwoord wijzigen – Films</PageTitle>

<div class="auth-shell auth-embedded"><div class="auth-card">
<h1>Wachtwoord wijzigen</h1>

@if (ErrorMessage is not null)
{
    <ul class="auth-error" role="alert">
        <li>@ErrorMessage</li>
    </ul>
}

<form method="post" action="@AuthEndpoints.ChangePasswordPath">
    <AntiforgeryToken />
    <input type="hidden" name="ReturnUrl" value="@(LocalUrl.IsLocal(ReturnUrl) ? ReturnUrl : "")" />
    <label for="current">Huidig wachtwoord</label>
    <input id="current" name="CurrentPassword" type="password" autocomplete="current-password" maxlength="256" required />
    <label for="new">Nieuw wachtwoord</label>
    <input id="new" name="NewPassword" type="password" autocomplete="new-password" maxlength="256" required />
    <label for="confirm">Bevestig nieuw wachtwoord</label>
    <input id="confirm" name="ConfirmPassword" type="password" autocomplete="new-password" maxlength="256" required />
    <button type="submit">Wachtwoord wijzigen</button>
</form>
</div></div>

@code {
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? Error { get; set; }

    private string? ErrorMessage =>
        Error switch
        {
            "invalid" => "Controleer de eisen voor het wachtwoord en probeer het opnieuw.",
            "current" => "Het huidige wachtwoord is onjuist.",
            "failed" => "Het wachtwoord kon niet worden gewijzigd. Controleer de eisen en probeer het opnieuw.",
            _ => null,
        };
}
